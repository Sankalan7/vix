{
  "manifest_version": 3,
  "name": "VIX",
  "version": "1.0.0",
  "description": "Lightning-fast code error explanations.",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://vix-theta.vercel.app http://localhost:3001"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Debugger",
    "default_icon": "icon_128.png"
  },
  "icons": {
    "16": "icon_16.png",
    "48": "icon_48.png",
    "128": "icon_128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://vix-theta.vercel.app/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentSocialBlocker.js"]
    }
  ]
}
