{
  "manifest_version": 3,
  "name": "VIX",
  "version": "1.0.0",
  "description": "Lightning-fast code error explanations.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Debugger",
    "default_icon": "icon_128.png"
  },
  "icons": {
    "16": "icon_16.png",
    "48": "icon_48.png",
    "128": "icon_128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "content.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:3001 http://127.0.0.1:3001 http://localhost:3000 http://127.0.0.1:3000;"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vix@sankalan.com",
      "strict_min_version": "109.0"
    }
  }
}
